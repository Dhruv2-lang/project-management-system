# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/project_management"

# Secret used to sign JWTs. Use a long random value (>= 32 chars in production), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=development

# Allowed browser origin(s) for CORS, comma-separated. In development, any localhost port is also allowed.
CLIENT_URL="http://localhost:5173"

# Optional tuning
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300
TRUST_PROXY=0

# Only used by `npm test`: a SEPARATE database (its name must contain "test"); tables are wiped by the tests.
TEST_DATABASE_URL="postgresql://postgres:change_me@localhost:5432/project_management_test"
