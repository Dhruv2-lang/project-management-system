# Base URL of the Express API (must end with /api).
# Copy this file to `.env` and adjust. Restart `npx expo start` after changing it.
#
# Local development (the app maps localhost -> 10.0.2.2 automatically on the Android emulator):
EXPO_PUBLIC_API_URL=http://localhost:5000/api
#
# Physical device on the same Wi-Fi: use your computer's LAN IP, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api
# Production:
#   EXPO_PUBLIC_API_URL=https://<deployed-backend>/api
